---
import Head from '../components/Head.astro';
import { B, DATA, page as find } from '../lib/site.js';
// page: nav key • path: address when it differs from "<page>/" • scripts: files from public/js
const { page, path = page + '/', title, description, heading, scripts = [] } = Astro.props;
const emblem = B + 'assets/emblem.webp';
const BAR = ['market', 'calculator', null, 'wallet'];   // null = home button in the middle
const MORE = ['products', 'invoice', 'analysis', 'live', 'sources', 'guide'];
const moreIcon = 'M5 12h.01M12 12h.01M19 12h.01';
const name = heading || find(page)?.t || 'دهبولوجي';
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<Head title={title} description={description} path={path} theme="#0a1628" />
<link rel="stylesheet" href={B + 'design.css'}>
<link rel="stylesheet" href={B + 'dark.css'}>
<link rel="stylesheet" href={B + 'products.css'}>
<link rel="stylesheet" href={B + 'site.css'}>
<link rel="stylesheet" href={B + 'app.css'}>
<slot name="head" />
</head>
<body style={`--x-logo:url(${B}assets/logo-900.webp)`}>
<header class="x-top">
  <a class="x-home" href={B} aria-label="دهبولوجي — الصفحة الرئيسية"><img src={emblem} alt="" width="48" height="48"></a>
  <h1>{name}</h1>
  <button id="refresh" class="x-refresh" type="button" aria-label="تحديث الأسعار">↻</button>
</header>
<main class="wrap">
  <p class="x-status" role="status" aria-live="polite"><span id="fetchStatus">تحميل الأسعار…</span></p>
  <div id={'panel-' + page} data-panel={page}><slot /></div>
</main>
<footer><div class="wrap">لوحة متابعة مستقلة؛ ليست متجرًا ولا توصية شراء. <a href={B + 'sources/'}>المصادر</a> · <a href={B + 'guide/#faq'}>الأسئلة</a> · <a href="https://github.com/ahmedmah1989/gold-board/issues/new" target="_blank" rel="noopener">الإبلاغ عن خطأ</a></div></footer>

<div class="x-dock" role="navigation" aria-label="التنقل">
  {BAR.map(k => k === null
    ? <a class="x-dock-home" href={B}><img src={emblem} alt="" width="58" height="58"><span>الرئيسية</span></a>
    : <a href={B + k + '/'} aria-current={k === page ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={find(k).d} /></svg><span>{find(k).t}</span>
      </a>)}
  <details class={MORE.includes(page) ? 'on' : undefined}>
    <summary><svg viewBox="0 0 24 24" aria-hidden="true"><path d={moreIcon} stroke-width="3" /></svg><span>المزيد</span></summary>
    <div class="x-more-menu">
      {MORE.map(k => <a href={B + k + '/'} aria-current={k === page ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={find(k).d} /></svg><span>{find(k).t}</span>
      </a>)}
    </div>
  </details>
</div>

<script is:inline define:vars={{ B, DATA }}>window.DHB_BASE = B; window.DHB_DATA = DATA;</script>
<slot name="config" />
{scripts.map(s => <script is:inline src={B + 'js/' + s + '.js'}></script>)}
<slot name="scripts" />
</body>
</html>
