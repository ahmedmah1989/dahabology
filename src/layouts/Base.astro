---
import Head from '../components/Head.astro';
import Brand from '../components/Brand.astro';
import Watermark from '../components/Watermark.astro';
import { B, DATA, ASSET_VERSION, page as find } from '../lib/site.js';
// page: nav key • path: address when it differs from "<page>/" • scripts: files from public/js
const { page, path = page + '/', title, description, heading, scripts = [], informational = false } = Astro.props;
const asset=p=>B+p+'?v='+ASSET_VERSION;
const emblem = asset('assets/emblem.webp');
const BAR = ['market', 'calculator', null, 'wallet'];   // null = home button in the middle
const MORE = ['products', 'invoice', 'analysis', 'live', 'guide', 'about', 'assistant'];
const SHORT = { invoice: 'الفاتورة' };                  // shorter names inside the round buttons
const label = k => SHORT[k] || find(k).t;
const moreIcon = 'M5 12h.01M12 12h.01M19 12h.01';
const name = heading || find(page)?.t || 'دهبولوجي';
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<Head title={title} description={description} path={path} theme="#0a1628" />
<link rel="stylesheet" href={asset('design.css')}>
<link rel="stylesheet" href={asset('dark.css')}>
<link rel="stylesheet" href={asset('products.css')}>
<link rel="stylesheet" href={asset('site.css')}>
<link rel="stylesheet" href={asset('app.css')}>
<slot name="head" />
</head>
<body class="app-shell">
<Watermark />
<header class="x-top">
  <Brand />
  <h1>{name}</h1>
  {!informational && <button id="refresh" class="x-refresh" type="button" aria-label="إعادة تحميل الأسعار">↻</button>}
</header>
<main class="wrap">
  {!informational && <p class="x-status" role="status" aria-live="polite"><span id="fetchStatus">تحميل الأسعار…</span></p>}
  <div id={'panel-' + page} data-panel={page}><slot /></div>
</main>
<footer><div class="wrap"><span class="dhb-footer-brand">دهبولوجي.. افهم الدهب قبل ما تشتريه.</span>منصة معلوماتية وتحليلية؛ ليست جهة لبيع الذهب أو تقديم توصيات استثمارية شخصية. <a href={B + 'assistant/'}>المساعد الذكي</a> · <a href={B + 'about/'}>حكايتنا</a> · <a href={B + 'guide/'}>الأسئلة وطريقة الحساب</a></div></footer>

<div class="x-dock" role="navigation" aria-label="التنقل">
  {BAR.map(k => k === null
    ? <a class="x-dock-home" href={B}><img src={emblem} alt="" width="80" height="80"><span>الرئيسية</span></a>
    : <a href={B + k + '/'} aria-current={k === page ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={find(k).d} /></svg><span>{label(k)}</span>
      </a>)}
  <details class={MORE.includes(page) ? 'on' : undefined}>
    <summary><svg viewBox="0 0 24 24" aria-hidden="true"><path d={moreIcon} stroke-width="3" /></svg><span>المزيد</span></summary>
    <div class="x-more-menu">
      {MORE.map(k => <a href={B + k + '/'} aria-current={k === page ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={find(k).d} /></svg><span>{label(k)}</span>
      </a>)}
    </div>
  </details>
</div>

<script is:inline define:vars={{ B, DATA }}>window.DHB_BASE = B; window.DHB_DATA = DATA;</script>
<slot name="config" />
{scripts.map(s => <script is:inline src={asset('js/' + s + '.js')}></script>)}
<slot name="scripts" />
<script is:inline>
(()=>{const menu=document.querySelector('.x-dock details');if(!menu)return;
document.addEventListener('click',e=>{if(menu.open&&!menu.contains(e.target))menu.open=false;});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu.open){menu.open=false;menu.querySelector('summary').focus();}});
addEventListener('pagehide',()=>{menu.open=false;});})();
</script>
</body>
</html>
