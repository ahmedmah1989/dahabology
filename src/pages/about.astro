---
import Base from '../layouts/Base.astro';
import { B, ASSET_VERSION } from '../lib/site.js';
---
<Base page="about" informational title="دهبولوجي | حكايتنا" description="من ذهب الفراعنة إلى ذكاء الأسواق الحديثة. حكاية اسم دهبولوجي، وقناع توت عنخ آمون، ورسالتنا لفهم سوق الذهب في مصر.">
  <article class="dhb-story">
    <header class="story-hero">
      <span class="story-eyebrow">أصالة مصرية · معرفة معاصرة</span>
      <img src={B+'assets/logo-900.webp?v='+ASSET_VERSION} width="900" height="900" alt="شعار دهبولوجي يجمع حرف D وقناع توت عنخ آمون" />
      <h2>من ذهب الفراعنة<br /><span>إلى ذكاء الأسواق الحديثة.</span></h2>
      <p>الذهب مش مجرد سعر بيتغيّر كل يوم.<br />وراء كل رقم حكاية تستحق الفهم.</p>
    </header>
    <section class="story-name" aria-labelledby="name-story">
      <span class="story-eyebrow">الاسم بداية الحكاية</span>
      <h2 id="name-story">يعني إيه دهبولوجي؟</h2>
      <div class="story-equation" aria-label="دهب زائد لوجي يساوي دهبولوجي"><b>دهب</b><span>+</span><b>لوجي</b><span>=</span><b>دهبولوجي</b></div>
      <p>«دهب» هو المعدن اللي ارتبط بتاريخ مصر وحضارتها من آلاف السنين، و«لوجي» مستوحاة من المصطلحات المرتبطة بالعلم والمعرفة.</p>
      <p>ومن هنا اتولد اسم <strong>دهبولوجي</strong>؛ لأننا شايفين إن سوق الذهب محتاج فهم وتحليل ومقارنة، مش متابعة السعر وبس.</p>
    </section>
    <section class="story-pair" aria-label="الرمز والرسالة">
      <div><span class="story-eyebrow">رمزنا</span><h2>ليه قناع توت عنخ آمون؟</h2><p>واحد من أشهر الرموز الذهبية للحضارة المصرية القديمة، وشاهد على براعة المصريين في صناعة الذهب.</p><p>القناع في هويتنا بيرمز إلى <strong>الأصالة والقيمة والإبداع المصري</strong>، بينما الأدوات والمؤشرات الحديثة بتمثل المعرفة والتكنولوجيا. بنجمع تاريخ الذهب ومستقبله في هوية واحدة.</p></div>
      <div><span class="story-eyebrow">إحنا مين؟</span><h2>نقرّب لك الصورة.</h2><p>دهبولوجي منصة معلوماتية متخصصة في متابعة وفهم سوق الذهب في مصر.</p><p>بنقدّم الأسعار والمؤشرات والحسابات بصورة واضحة ومنظمة، علشان تفهم حركة السوق، وتقارن بين الخيارات، وتعرف العوامل المؤثرة على الأسعار.</p></div>
    </section>
    <section aria-labelledby="story-tools"><span class="story-eyebrow">بنقدّم إيه؟</span><h2 id="story-tools">من متابعة الرقم… لفهم معناه.</h2><div class="story-tools">
      <div><b>تابع</b><span>أسعار الذهب بمختلف العيارات</span></div>
      <div><b>قارن</b><span>السبائك والجنيهات وأسعار المنتجات</span></div>
      <div><b>احسب</b><span>الوزن والتكلفة قبل الشراء</span></div>
      <div><b>افهم</b><span>المؤشرات وحركة سوق الذهب</span></div>
    </div></section>
    <section class="story-mission"><span class="story-eyebrow">رسالتنا</span><h2>نحوّل أرقام سوق الذهب إلى معلومات مفهومة تساعد على اتخاذ قرارات أكثر وعيًا.</h2></section>
    <section aria-labelledby="story-values"><h2 id="story-values">مبادئنا في كل تفصيلة</h2><dl class="story-values">
      <div><dt>الوضوح</dt><dd>نشرح الأرقام والمصطلحات بلغة بسيطة.</dd></div>
      <div><dt>الدقة والشفافية</dt><dd>نوضّح معنى السعر وحدود المقارنة، ونميّز السعر الاسترشادي عن التكلفة النهائية، من غير وعود مضللة.</dd></div>
      <div><dt>المعرفة</dt><dd>نساعدك تفهم قبل ما تقرر.</dd></div>
      <div><dt>الهوية المصرية</dt><dd>نفتخر بتاريخ مصر وعلاقتها الممتدة بالذهب.</dd></div>
    </dl></section>
    <div class="story-end"><p>دهبولوجي.. افهم الدهب قبل ما تشتريه.</p></div>
  </article>
</Base>
