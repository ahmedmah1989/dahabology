---
import { B } from '../lib/site.js';
const to = B + 'market/#analysis';
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>تحليل الذهب — دهبولوجي</title>
<meta name="description" content="انتقل التحليل إلى صفحة السوق في دهبولوجي، تبويب التحليل.">
<meta name="robots" content="noindex">
<meta http-equiv="refresh" content={'0;url=' + to}>
<style>body{background:#070f1e;color:#d5e9fa;font-family:sans-serif;display:grid;place-items:center;min-height:100vh;margin:0;text-align:center}a{color:#9bd2ed}</style>
</head>
<body>
<script is:inline define:vars={{ to }}>location.replace(to);</script>
<p>التحليل صار جزءًا من صفحة السوق. <a href={to}>افتح تبويب التحليل من هنا</a>.</p>
</body>
</html>
