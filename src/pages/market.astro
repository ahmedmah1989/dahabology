---
import Base from '../layouts/Base.astro';
import html from '../panels/market.html?raw';
import { panel } from '../lib/site.js';
---
<Base page="market" heading="سعر الذهب الآن" scripts={['services', 'alerts', 'monitor', 'board', 'tools', 'market-view', 'silver-view']}
  title="سعر الذهب اليوم في مصر | عيار 21 و24 و18 والدولار الضمني — دهبولوجي"
  description="سعر بيع وشراء الذهب في مصر لعيار 21 و24 و18، سعر الدولار في البنك، الأونصة العالمية، ومؤشر الفجوة بين السعر المحلي والعالمي.">
  <Fragment set:html={panel(html, 'market')} />
</Base>

<style is:global>
.market-reference-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;align-items:start;margin:14px 0}
.market-reference-grid>.x-card{margin:0;min-width:0;overflow-wrap:anywhere;padding:14px 10px}.market-reference-grid h2{font-size:17px}.market-reference-grid .x-sub,.market-reference-grid .x-note{font-size:12px;line-height:1.7}.market-reference-grid #priceBank,.market-reference-grid #impVal{font-size:22px;line-height:1.6;display:block}.market-reference-grid #silverCard{grid-column:1/-1}.market-reference-grid #silverCard h3{font-size:14px;margin:8px 0}.market-reference-grid details{font-size:12px}.market-reference-grid .price-unit{display:block}
@media(min-width:850px){.market-reference-grid{grid-template-columns:1fr 1fr}.market-reference-grid #silverCard{grid-column:1/-1}}
</style>
