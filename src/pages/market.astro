---
import Base from '../layouts/Base.astro';
import html from '../panels/market.html?raw';
import { panel } from '../lib/site.js';
---
<Base page="market" heading="سعر الذهب الآن" scripts={['services', 'alerts', 'monitor', 'board', 'tools', 'market-view']}
  title="سعر الذهب اليوم في مصر | عيار 21 و24 و18 والدولار الضمني — دهبولوجي"
  description="سعر بيع وشراء الذهب في مصر لعيار 21 و24 و18، سعر الدولار في البنك، الأونصة العالمية، ومؤشر الفجوة بين السعر المحلي والعالمي.">
  <Fragment set:html={panel(html, 'market')} />
</Base>
