---
import { B, ASSET_VERSION } from '../lib/site.js';
const { compact = false } = Astro.props;
const image = B + 'assets/tut-welcome-' + (compact ? '160' : '320') + '.webp?v=' + ASSET_VERSION;
---
<div class:list={['dhb-tut', { 'dhb-tut-small': compact }]}>
  <div class="tut-character">
    <img src={image} width="320" height="320" alt="شعار دهبولوجي بحرف D وتوت، يمد إيدًا للترحيب والمساعدة" decoding="async" />
    <svg class="tut-eye-energy" viewBox="0 0 1280 1280" aria-hidden="true">
      <g class="tut-eye-sparks" fill="none">
        <path d="m578 256-32-3-12 6-18-13-18 5-22-11M651 256l32-3 12 6 18-13 18 5 22-11" />
      </g>
    </svg>
  </div>
</div>
